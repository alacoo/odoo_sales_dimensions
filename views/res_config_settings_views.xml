<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_dimensions" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.dimensions</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[1]" position="before">
                <block title="طباعة ومخزون" name="print_stock_link">
                    <setting string="ربط الطباعة بالمخزون" help="خصم تلقائي من المخزون عند إكمال مهمة طباعة أو تسجيل هدر. أوقفه مؤقتاً أثناء الجرد أو تصحيح بيانات المخزون.">
                        <field name="enable_print_stock_link"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
